# No trailing slash: a `node_modules/` pattern matches directories only, and a symlinked
# node_modules (which is what a linked local install leaves) would slip through and be committed
# as a link into somebody's temp folder.
node_modules
*.zip
.DS_Store

# Host page for test/bridge.mjs, written at run time so the extension's modules can be imported
# over http — real module resolution is what makes a missing import fail there.
test/.bridge-host.html

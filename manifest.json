{
  "manifest_version": 3,
  "name": "AutoLancers",
  "version": "0.1.0",
  "description": "Read the marketplace page you have open — Upwork or PeoplePerHour — and export what it holds.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8010/*",
    "https://www.upwork.com/*",
    "https://upwork.com/*",
    "https://www.peopleperhour.com/*",
    "https://peopleperhour.com/*"
    // Fiverr is parked. Re-enabling it is these two lines plus `enabled: false` in the Fiverr entry
    // of src/content/platforms.js and src/background/worker.js. All three move together: recognising
    // a site Chrome will refuse to let us read is what produces "Cannot access contents of url",
    // after the popup has already offered to read the page.
    // "https://www.fiverr.com/*",
    // "https://fiverr.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://autolancers.app/*",
      "https://*.autolancers.app/*"
    ]
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AutoLancers"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  }
}
